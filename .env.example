# ─────────────────────────────────────────────────────────────────────────────
# SelloEasy — environment variables (single source of truth, ADR-0012)
#
#   cp .env.example .env      # then set OPENROUTER_API_KEY
#   docker compose up --build
#
# Values below work for local development as-is. docker-compose.yml overrides the
# container-network hosts (postgres, redis, minio, mailpit) automatically.
# Every key is validated at boot by packages/shared/src/env.ts — a wrong value fails fast.
# Full reference: http://localhost:3000/docs/getting-started/environment-variables
# ─────────────────────────────────────────────────────────────────────────────

############################################
# 1. LLM — provider switch (plan2 §10)
############################################
# openrouter | openai | anthropic. The app uses EXACTLY the selected provider's *_MODEL value —
# there is no model name in source code (ADR-0009). OpenRouter is the documented default for the submission.
LLM_PROVIDER=openrouter
# live | mock — with no API key for the selected provider the app auto-falls back to mock (logged loudly).
LLM_MODE=live
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_MS=30000
LLM_CACHE_TTL_SECONDS=604800
# Optional failover provider (must also be configured below); used after retries fail with 5xx/timeouts.
LLM_FALLBACK_PROVIDER=
# Capability overrides for models newer than the built-in table: true | false | empty (auto)
LLM_SUPPORTS_TEMPERATURE=
LLM_SUPPORTS_JSON_SCHEMA=
# USD per 1M tokens for providers that don't report cost (OpenAI, Anthropic). Empty = cost shown as n/a.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (direct) — set LLM_PROVIDER=openai to use it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
# minimal | low | medium | high (reasoning models only)
OPENAI_REASONING_EFFORT=low

# Anthropic (direct) — set LLM_PROVIDER=anthropic to use it
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

############################################
# 2. App runtime
############################################
NODE_ENV=development
# local | staging | production
APP_ENV=local
LOG_LEVEL=info
# Public URL of the web app (used in invite / reset links)
WEB_URL=http://localhost:3000
# Where the Next.js server proxies /api/* (compose overrides to http://api:4000)
API_INTERNAL_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
# Standalone docs site (apps/docs-site, Fumadocs) — renders the whole docs/ folder
DOCS_PORT=3001
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
# true behind HTTPS (AWS)
COOKIE_SECURE=false
# true behind ALB/CloudFront
TRUST_PROXY=false

############################################
# 3. Auth & security
############################################
JWT_ACCESS_SECRET=change-me-local-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-local-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
INVITE_TTL_HOURS=72
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1m
# Bootstrap super admin (created if missing). In AWS the password comes from Secrets Manager.
SUPERADMIN_EMAIL=superadmin@selloeasy.local
SUPERADMIN_PASSWORD=Admin@123

############################################
# 4. Database — Postgres (local container | RDS)
############################################
DATABASE_URL=postgres://selloeasy:selloeasy@localhost:5432/selloeasy
# true for RDS
DATABASE_SSL=false
# RDS CA bundle baked into the images
DATABASE_SSL_CA_FILE=/app/certs/rds-global-bundle.pem
DATABASE_POOL_MAX=10
# Used by the local postgres container only
POSTGRES_USER=selloeasy
POSTGRES_PASSWORD=selloeasy
POSTGRES_DB=selloeasy

############################################
# 5. Redis — (local container | ElastiCache)
############################################
# rediss://… for ElastiCache in-transit encryption
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

############################################
# 6. Object storage — (MinIO | S3)
############################################
# minio | s3
STORAGE_DRIVER=minio
S3_BUCKET=selloeasy-uploads
S3_REGION=ap-south-1
# Leave EMPTY for AWS S3
S3_ENDPOINT=http://localhost:9000
# Browser-reachable endpoint for presigned upload URLs (local MinIO)
S3_PUBLIC_ENDPOINT=http://localhost:9000
# false for AWS S3
S3_FORCE_PATH_STYLE=true
# Leave EMPTY on AWS (the ECS task role is used)
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
UPLOAD_MAX_MB=20

############################################
# 7. Email — (SMTP/Mailpit | SES)
############################################
# smtp | ses
MAIL_DRIVER=smtp
MAIL_FROM="SelloEasy <no-reply@selloeasy.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Required when MAIL_DRIVER=ses
SES_REGION=ap-south-1
SES_CONFIGURATION_SET=

############################################
# 8. Pipeline & product defaults
############################################
PIPELINE_SCHEDULE_CRON=0 */6 * * *
PIPELINE_MATCH_THRESHOLD=0.6
PIPELINE_MAX_LLM_CALLS_PER_RUN=60
PIPELINE_EVENT_WINDOW_DAYS=180
PIPELINE_BATCH_SIZE=8
LEADS_PAGE_SIZE_DEFAULT=6
CRAWL_MAX_PAGES=25
CRAWL_MAX_DEPTH=2
FEATURE_LEAD_VISIBILITY_TOGGLE=false

############################################
# 8b. Platform data source — imports & ingestion (plan2)
############################################
# Per-file limits for CSV / JSONL / JSON imports
IMPORT_MAX_MB=10
IMPORT_MAX_ROWS=5000
# A commit is refused when more than this share of rows is invalid (garbage-file guard)
IMPORT_MAX_INVALID_RATIO=0.2
# Oldest acceptable published_at for imported/ingested events, in days
DATA_MAX_AGE_DAYS=730
# Upper bound of rows pulled by one connector ingestion run
INGESTION_MAX_ROWS_PER_RUN=500
# Optional LLM quality gate on import (flags rows that don't look like real B2B events as warnings)
IMPORT_AI_GATE_ENABLED=false
IMPORT_AI_GATE_MAX_CALLS=10
# Staged import rows are purged this many days after commit/discard
STAGING_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

############################################
# 9. Seed / demo
############################################
# false in AWS staging/prod
SEED_ON_START=true
# 5 synthetic orgs + ~300 events
SEED_DEMO_DATA=true

############################################
# 10. Observability
############################################
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=selloeasy

############################################
# 11. Secrets source
############################################
# env | aws-secrets-manager
SECRETS_SOURCE=env
# e.g. selloeasy/production/app (JSON secret) — loaded at boot, overrides env
AWS_SECRETS_ID=

############################################
# 12. AWS deployment (read by infra/ CDK + deploy scripts; leave empty for local)
############################################
AWS_ACCOUNT_ID=
AWS_REGION=ap-south-1
# Local CLI profile used by `pnpm deploy:aws` (or use CI OIDC)
AWS_PROFILE=
# staging | production — prefixes all stack/resource names
DEPLOY_ENV=staging
# e.g. app.selloeasy.com
DOMAIN_NAME=
# Route53 zone for DOMAIN_NAME
HOSTED_ZONE_ID=
# Optional; CDK creates one via DNS validation if empty
ACM_CERTIFICATE_ARN=
ECR_REPOSITORY_PREFIX=selloeasy
# CI sets the git SHA
IMAGE_TAG=latest
# Optional; empty = CDK creates a new VPC
VPC_ID=
NAT_GATEWAYS=1
RDS_INSTANCE_CLASS=t4g.micro
RDS_ALLOCATED_STORAGE_GB=20
RDS_MULTI_AZ=false
RDS_BACKUP_RETENTION_DAYS=7
REDIS_NODE_TYPE=cache.t4g.micro
ECS_API_CPU=512
ECS_API_MEMORY=1024
ECS_API_DESIRED_COUNT=1
ECS_WORKER_CPU=512
ECS_WORKER_MEMORY=1024
ECS_WORKER_DESIRED_COUNT=1
ECS_WEB_CPU=256
ECS_WEB_MEMORY=512
ECS_WEB_DESIRED_COUNT=1
# SNS subscription for CloudWatch alarms
ALARM_EMAIL=
# CI deploy role (created by the bootstrap stack)
GITHUB_OIDC_ROLE_ARN=
