# Dummy AWS deploy configuration used by `pnpm --filter @selloeasy/infra synth:check` (CI, no AWS account needed).
# Mirrors .env.example group 12 + the secrets the deploy script pushes. None of these values are real.
AWS_ACCOUNT_ID=123456789012
AWS_REGION=ap-south-1
DEPLOY_ENV=staging
DOMAIN_NAME=app.example.com
HOSTED_ZONE_ID=Z0000000000000000000
ACM_CERTIFICATE_ARN=
ECR_REPOSITORY_PREFIX=selloeasy
IMAGE_TAG=0000000
VPC_ID=
NAT_GATEWAYS=1
RDS_INSTANCE_CLASS=t4g.micro
RDS_ALLOCATED_STORAGE_GB=20
RDS_MULTI_AZ=false
RDS_BACKUP_RETENTION_DAYS=7
REDIS_NODE_TYPE=cache.t4g.micro
ECS_API_CPU=512
ECS_API_MEMORY=1024
ECS_API_DESIRED_COUNT=1
ECS_WORKER_CPU=512
ECS_WORKER_MEMORY=1024
ECS_WORKER_DESIRED_COUNT=1
ECS_WEB_CPU=256
ECS_WEB_MEMORY=512
ECS_WEB_DESIRED_COUNT=1
ALARM_EMAIL=alerts@example.com
GITHUB_OIDC_ROLE_ARN=
GITHUB_REPOSITORY=example-org/selloeasy

# Secrets / app values the deploy script pushes into Secrets Manager.
OPENROUTER_API_KEY=dummy
OPENROUTER_MODEL=google/gemini-2.5-flash
MAIL_FROM="SelloEasy <no-reply@app.example.com>"
SES_REGION=ap-south-1
JWT_ACCESS_SECRET=fixture-access-secret-0123456789abcdef0123456789
JWT_REFRESH_SECRET=fixture-refresh-secret-0123456789abcdef012345678
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=fixture-Password-123
